{
  "name": "sevasetu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SevaSetu - Multifunctional Home & Local Services Platform",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,magenta.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "build:shared": "npm run build --workspace=shared",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "typecheck": "npm run typecheck:shared && npm run typecheck:server && npm run typecheck:client",
    "typecheck:shared": "npm run typecheck --workspace=shared",
    "typecheck:server": "npm run typecheck --workspace=server",
    "typecheck:client": "npm run typecheck --workspace=client",
    "prisma:generate": "npm run prisma:generate --workspace=server",
    "prisma:validate": "npm run prisma:validate --workspace=server",
    "test": "npm run test --workspace=server",
    "test:phase2": "npm run test:phase2 --workspace=server",
    "test:phase3": "npm run test:phase3 --workspace=server",
    "test:phase4": "npm run test:phase4 --workspace=server",
    "test:phase5": "npm run test:phase5 --workspace=server",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
