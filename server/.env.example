# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/sevasetu?schema=public

# Payment Gateway Configuration (Production / Sandbox)
PAYMENT_GATEWAY_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Financial & Marketplace Policies (Server-Only)
# Configurable percentage commission taken by platform on completed jobs (e.g. 10)
PLATFORM_COMMISSION_PERCENT=
# Hours prior to scheduled start time within which cancellation is 100% free (e.g. 2)
CANCELLATION_FREE_WINDOW_HOURS=
# Percentage fee retained when customer cancels after the free window (e.g. 20)
CANCELLATION_LATE_FEE_PERCENT=

