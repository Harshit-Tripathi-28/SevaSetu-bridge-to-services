{
  "name": "@sevasetu/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema=prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema=prisma/schema.prisma",
    "seed:catalog": "tsx src/scripts/seed-catalog.ts",
    "test": "tsx src/tests/auth.test.ts && tsx src/tests/phase2.test.ts && tsx src/tests/phase3.test.ts && tsx src/tests/phase4.test.ts && tsx src/tests/phase5.test.ts && tsx src/tests/phase6.test.ts && tsx src/tests/phase7.test.ts",
    "test:auth": "tsx src/tests/auth.test.ts",
    "test:phase2": "tsx src/tests/phase2.test.ts",
    "test:phase3": "tsx src/tests/phase3.test.ts",
    "test:phase4": "tsx src/tests/phase4.test.ts",
    "test:phase5": "tsx src/tests/phase5.test.ts",
    "test:phase6": "tsx src/tests/phase6.test.ts",
    "test:phase7": "tsx src/tests/phase7.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sevasetu/shared": "*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.10",
    "prisma": "^6.19.3",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
