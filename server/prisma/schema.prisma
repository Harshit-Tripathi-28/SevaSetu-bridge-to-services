// Prisma Schema for SevaSetu
// PostgreSQL Datasource & Client Generator Configuration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum PricingModel {
  HOURLY
  FIXED
  PER_VISIT
  PER_TASK
  QUOTE
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  phone        String?       @unique
  fullName     String?
  passwordHash String
  role         Role          @default(CUSTOMER)
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  addresses       Address[]
  providerProfile ServiceProviderProfile?
  serviceRequests ServiceRequest[]
  customerBookings Booking[]
  payments        Payment[]
  invoices        Invoice[]
  reviews         Review[]
  conversations   Conversation[]
  sentMessages    Message[]
  notifications   Notification[]
  notificationPreference NotificationPreference?
  reportsMade     Report[]                 @relation("ReportedBy")
  reportsReceived Report[]                 @relation("ReportedUser")
  blocksInitiated Block[]                  @relation("BlockedBy")
  blocksReceived  Block[]                  @relation("BlockedUser")

  // Phase 7 Governance & Operations relations
  assignedReports        Report[]               @relation("ReportAssignedAdmin")
  verificationReviews    VerificationRecord[]   @relation("VerificationReviewedBy")
  disputesOpened         Dispute[]              @relation("DisputeOpenedBy")
  disputesRespondent     Dispute[]              @relation("DisputeRespondent")
  disputesAssigned       Dispute[]              @relation("DisputeAssignedAdmin")
  supportTickets         SupportTicket[]        @relation("SupportTicketRequester")
  supportTicketsAssigned SupportTicket[]        @relation("SupportTicketAssignedAdmin")
  trustSafetyCases       TrustSafetyCase[]      @relation("TrustSafetyAssignedAdmin")
  auditLogs              AuditLog[]             @relation("AuditLogActor")

  // Phase 8 AI relations
  aiInteractions           AiInteraction[]
  aiRequestInterpretations AiRequestInterpretation[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model Address {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      AddressLabel @default(HOME)
  flatNumber String
  streetArea String
  city       String
  state      String?      @default("Uttar Pradesh")
  postalCode String
  landmark   String?
  isDefault  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  serviceRequests ServiceRequest[]

  @@index([userId])
  @@index([userId, isDefault])
}

model ServiceCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String
  iconName    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  services    Service[]

  @@index([slug])
  @@index([isActive])
}

model Service {
  id               String       @id @default(uuid())
  categoryId       String
  category         ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title            String
  slug             String       @unique
  description      String
  serviceType      String?      @default("standard")
  pricingModel     PricingModel @default(FIXED)
  basePrice        Float?
  durationMinutes  Int?
  includedFeatures String[]     @default([])
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  providerServices ProviderService[]
  serviceRequests  ServiceRequest[]
  bookings         Booking[]

  @@index([categoryId])
  @@index([slug])
  @@index([isActive])
}

model ServiceProviderProfile {
  id                 String           @id @default(uuid())
  userId             String           @unique
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String?
  bio                String?
  experienceYears    Int              @default(0)
  languages          String[]         @default(["Hindi", "English"])
  serviceAreaSummary String?
  avatarUrl          String?
  isPubliclyListed   Boolean          @default(false)
  onboardingStatus   OnboardingStatus @default(NOT_STARTED)
  vacationMode       Boolean          @default(false)
  rating             Float            @default(0)
  reviewCount        Int              @default(0)
  isRestricted       Boolean          @default(false)
  restrictionReason  String?
  isVerified         Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  skills                ProviderSkill[]
  services              ProviderService[]
  serviceAreas          ProviderServiceArea[]
  availabilities        ProviderAvailability[]
  availabilityOverrides ProviderAvailabilityOverride[]
  serviceRequests       ServiceRequest[]
  bookings              Booking[]
  payments              Payment[]
  invoices              Invoice[]
  earnings              ProviderEarning[]
  payouts               ProviderPayout[]
  reviews               Review[]
  conversations         Conversation[]
  verificationRecords   VerificationRecord[]
  aiReviewSummary       AiReviewSummary?

  @@index([userId])
  @@index([onboardingStatus])
  @@index([isPubliclyListed])
  @@index([isRestricted])
  @@index([isVerified])
}

model ProviderSkill {
  id                String                 @id @default(uuid())
  providerProfileId String
  providerProfile   ServiceProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  name              String
  category          String
  experienceLevel   String                 @default("intermediate") // beginner | intermediate | expert
  createdAt         DateTime               @default(now())

  @@index([providerProfileId])
}

model ProviderService {
  id                String                 @id @default(uuid())
  providerProfileId String
  providerProfile   ServiceProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  serviceId         String
  service           Service                @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customTitle       String?
  description       String?
  pricingModel      PricingModel?
  customPrice       Float?
  minDuration       String?
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([providerProfileId, serviceId])
  @@index([providerProfileId])
  @@index([serviceId])
}

model ProviderServiceArea {
  id                String                 @id @default(uuid())
  providerProfileId String
  providerProfile   ServiceProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  city              String
  locality          String
  state             String                 @default("Uttar Pradesh")
  postalCode        String
  radiusKm          Float                  @default(10.0)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([providerProfileId])
  @@index([city, postalCode])
}

model ProviderAvailability {
  id                String                 @id @default(uuid())
  providerProfileId String
  providerProfile   ServiceProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  dayOfWeek         DayOfWeek
  startTime         String                 // e.g. "09:00"
  endTime           String                 // e.g. "18:00"
  breakStart        String?                // e.g. "13:00"
  breakEnd          String?                // e.g. "14:00"
  isAvailable       Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([providerProfileId, dayOfWeek])
  @@index([providerProfileId])
  @@index([dayOfWeek])
}

model ProviderAvailabilityOverride {
  id                String                 @id @default(uuid())
  providerProfileId String
  providerProfile   ServiceProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  date              DateTime               @db.Date
  startTime         String?                // e.g. "09:00"
  endTime           String?                // e.g. "14:00"
  isAvailable       Boolean                @default(false)
  reason            String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([providerProfileId, date])
  @@index([providerProfileId])
  @@index([providerProfileId, date])
}

enum ServiceRequestStatus {
  SUBMITTED
  PENDING_PROVIDER
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum BookingStatus {
  PENDING_PROVIDER
  ACCEPTED
  SCHEDULED
  ON_THE_WAY
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DECLINED
  EXPIRED
}

enum BookingActorType {
  CUSTOMER
  PROVIDER
  SYSTEM
}

model ServiceRequest {
  id                     String                 @id @default(uuid())
  customerId             String
  customer               User                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  serviceId              String
  service                Service                @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  selectedProviderId     String?
  selectedProvider       ServiceProviderProfile? @relation(fields: [selectedProviderId], references: [id], onDelete: SetNull)
  description            String
  requestedDate          DateTime               @db.Date
  requestedStartTime     String                 // "HH:mm" e.g. "10:00"
  requestedDurationHours Float                  @default(1.0)
  addressId              String?
  address                Address?               @relation(fields: [addressId], references: [id], onDelete: SetNull)
  addressSnapshot        Json                   // Immutable address snapshot at request time
  preferences            Json?                  // instructions, access, hasPets, parking, etc.
  status                 ServiceRequestStatus   @default(PENDING_PROVIDER)
  rebookedFromBookingId  String?
  rebookedFromBooking    Booking?               @relation("RebookedFrom", fields: [rebookedFromBookingId], references: [id], onDelete: SetNull)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  bookings               Booking[]

  @@index([customerId])
  @@index([serviceId])
  @@index([selectedProviderId])
  @@index([status])
  @@index([requestedDate])
  @@index([rebookedFromBookingId])
}

model Booking {
  id                    String                 @id @default(uuid())
  referenceCode         String                 @unique // e.g. "BK-YYYYMMDD-XXXX"
  serviceRequestId      String
  serviceRequest        ServiceRequest         @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  customerId            String
  customer              User                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  providerProfileId     String
  providerProfile       ServiceProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  serviceId             String
  service               Service                @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  scheduledDate         DateTime               @db.Date
  scheduledStartTime    String                 // e.g. "10:00"
  scheduledEndTime      String                 // e.g. "12:00"
  durationHours         Float                  @default(1.0)
  status                BookingStatus          @default(PENDING_PROVIDER)

  // Snapshots (Immutable historical data)
  serviceTitleSnapshot  String
  pricingModelSnapshot  PricingModel           @default(FIXED)
  priceSnapshot         Float?
  locationSnapshot      Json                   // { flatNumber, streetArea, city, state, postalCode, landmark }
  customerSnapshot      Json                   // { fullName, email, phone }
  providerSnapshot      Json                   // { businessName, displayName, phone, email }

  notes                 String?
  cancellationReason    String?
  cancelledBy           BookingActorType?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  statusHistory         BookingStatusHistory[]
  payments              Payment[]
  invoices              Invoice[]
  refunds               Refund[]
  earnings              ProviderEarning[]
  rebookedRequests      ServiceRequest[]       @relation("RebookedFrom")
  review                Review?
  conversation          Conversation?
  reports               Report[]
  disputes              Dispute[]
  supportTickets        SupportTicket[]

  @@index([customerId])
  @@index([providerProfileId])
  @@index([serviceId])
  @@index([serviceRequestId])
  @@index([scheduledDate])
  @@index([status])
  @@index([providerProfileId, scheduledDate, status])
}

model BookingStatusHistory {
  id             String           @id @default(uuid())
  bookingId      String
  booking        Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  previousStatus BookingStatus?
  newStatus      BookingStatus
  actorType      BookingActorType
  actorUserId    String?
  reason         String?
  metadata       Json?
  createdAt      DateTime         @default(now())

  @@index([bookingId])
  @@index([createdAt])
}

// ==========================================
// Phase 5: Real Payments, Invoices, Refunds & Provider Earnings
// ==========================================

enum PaymentStatus {
  CREATED
  PENDING
  PROCESSING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum EarningStatus {
  PENDING
  AVAILABLE
  DISBURSED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

model Payment {
  id                    String                 @id @default(uuid())
  referenceCode         String                 @unique // e.g. "PAY-20261001-XXXX"
  bookingId             String
  booking               Booking                @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customerId            String
  customer              User                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  providerProfileId     String
  providerProfile       ServiceProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)

  gatewayProvider       String                 @default("RAZORPAY")
  gatewayOrderId        String?                @unique
  gatewayPaymentId      String?                @unique
  idempotencyKey        String?                @unique

  // Amounts stored in integer minor units (paise for INR)
  amount                Int                    // total payable in paise
  baseAmount            Int                    // service base amount in paise
  taxAmount             Int                    @default(0) // statutory tax in paise
  platformFee           Int                    @default(0) // platform fee in paise
  discountAmount        Int                    @default(0) // discount in paise
  currency              String                 @default("INR")

  status                PaymentStatus          @default(CREATED)
  paymentMethod         String?                // "UPI", "CARD", "NETBANKING", "WALLET"

  failureCode           String?
  failureMessage        String?
  paidAt                DateTime?

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  statusHistory         PaymentStatusHistory[]
  invoices              Invoice[]
  refunds               Refund[]
  earnings              ProviderEarning[]

  @@index([bookingId])
  @@index([customerId])
  @@index([providerProfileId])
  @@index([status])
  @@index([gatewayOrderId])
  @@index([createdAt])
}

model PaymentStatusHistory {
  id             String         @id @default(uuid())
  paymentId      String
  payment        Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  previousStatus PaymentStatus?
  newStatus      PaymentStatus
  actorType      BookingActorType
  actorUserId    String?
  reason         String?
  metadata       Json?
  createdAt      DateTime       @default(now())

  @@index([paymentId])
  @@index([createdAt])
}

model Invoice {
  id                   String                 @id @default(uuid())
  invoiceNumber        String                 @unique // e.g. "INV-202610-00001"
  bookingId            String
  booking              Booking                @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  paymentId            String?
  payment              Payment?               @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  customerId           String
  customer             User                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  providerProfileId    String
  providerProfile      ServiceProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)

  serviceTitleSnapshot String
  serviceDate          DateTime               @db.Date
  customerSnapshot     Json                   // { fullName, email, phone, billingAddress }
  providerSnapshot     Json                   // { businessName, displayName, phone, email, taxRegistration }

  // Financial amounts in minor units (paise)
  subtotal             Int
  tax                  Int                    @default(0)
  platformFee          Int                    @default(0)
  discount             Int                    @default(0)
  total                Int
  currency             String                 @default("INR")

  paymentStatus        PaymentStatus          @default(PAID)
  paymentMethodMasked  String?
  issuedAt             DateTime               @default(now())
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  lineItems            InvoiceLineItem[]

  @@index([bookingId])
  @@index([customerId])
  @@index([providerProfileId])
  @@index([paymentId])
  @@index([issuedAt])
}

model InvoiceLineItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float    @default(1.0)
  unitPrice   Int      // in paise
  total       Int      // in paise
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model Refund {
  id                String           @id @default(uuid())
  refundReference   String           @unique // e.g. "RFND-20261001-XXXX"
  paymentId         String
  payment           Payment          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  bookingId         String
  booking           Booking          @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  gatewayRefundId   String?          @unique

  amount            Int              // in paise
  currency          String           @default("INR")
  status            RefundStatus     @default(PENDING)
  reason            String
  initiatedBy       BookingActorType @default(CUSTOMER)
  initiatedByUserId String?
  processedAt       DateTime?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([paymentId])
  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
}

model ProviderEarning {
  id                String                 @id @default(uuid())
  providerProfileId String
  providerProfile   ServiceProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  bookingId         String
  booking           Booking                @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  paymentId         String?
  payment           Payment?               @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  // Amounts in minor units (paise)
  grossAmount       Int
  platformFee       Int                    @default(0)
  taxDeduction      Int                    @default(0)
  netEarning        Int
  currency          String                 @default("INR")

  status            EarningStatus          @default(AVAILABLE)
  availableAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([bookingId, providerProfileId]) // DOUBLE-CREDIT PROTECTION
  @@index([providerProfileId])
  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
}

model ProviderPayout {
  id                  String                 @id @default(uuid())
  payoutReference     String                 @unique // e.g. "PO-202610-XXXX"
  providerProfileId   String
  providerProfile     ServiceProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)

  amount              Int                    // in paise
  currency            String                 @default("INR")
  status              PayoutStatus           @default(PENDING)
  bankDetailsSnapshot Json?
  failureReason       String?
  requestedAt         DateTime               @default(now())
  processedAt         DateTime?

  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([providerProfileId])
  @@index([status])
  @@index([requestedAt])
}

model InvoiceSequence {
  id           String   @id // e.g. "INV_SEQUENCE_202610"
  currentValue Int      @default(0)
  updatedAt    DateTime @updatedAt
}

// ==========================================
// Phase 6: Real Reviews, Booking Chat, Notifications & Rebooking
// ==========================================

model Review {
  id                String                 @id @default(uuid())
  bookingId         String                 @unique // One customer review per booking
  booking           Booking                @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customerId        String
  customer          User                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  providerProfileId String
  providerProfile   ServiceProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)

  overallRating     Int                    // 1-5 integer scale
  punctuality       Int?                   // 1-5 integer scale
  workmanship       Int?                   // 1-5 integer scale
  cleanliness       Int?                   // 1-5 integer scale
  communication     Int?                   // 1-5 integer scale
  reviewText        String?

  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  reports           Report[]

  @@index([providerProfileId])
  @@index([customerId])
  @@index([createdAt])
}

enum MessageType {
  TEXT
  SYSTEM
}

model Conversation {
  id                String                 @id @default(uuid())
  bookingId         String                 @unique // Booking-scoped conversation
  booking           Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId        String
  customer          User                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  providerProfileId String
  providerProfile   ServiceProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)

  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  messages          Message[]

  @@index([bookingId])
  @@index([customerId])
  @@index([providerProfileId])
  @@index([updatedAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String
  senderUser     User         @relation(fields: [senderUserId], references: [id], onDelete: Restrict)

  content        String
  messageType    MessageType  @default(TEXT)

  readAt         DateTime?
  editedAt       DateTime?
  deletedAt      DateTime?

  createdAt      DateTime     @default(now())

  reports        Report[]

  @@index([conversationId])
  @@index([senderUserId])
  @@index([createdAt])
  @@index([conversationId, createdAt])
}

enum NotificationType {
  BOOKING_REQUEST_RECEIVED
  BOOKING_ACCEPTED
  BOOKING_DECLINED
  BOOKING_CONFIRMED
  BOOKING_RESCHEDULED
  BOOKING_CANCELLED
  SERVICE_STATUS_UPDATED
  PAYMENT_UPDATED
  INVOICE_AVAILABLE
  REVIEW_REMINDER
  NEW_MESSAGE
  ACCOUNT_SECURITY
}

model Notification {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              NotificationType
  title             String
  message           String
  relatedEntityType String?          // "BOOKING", "PAYMENT", "INVOICE", "MESSAGE", "REVIEW"
  relatedEntityId   String?
  isRead            Boolean          @default(false)
  readAt            DateTime?
  createdAt         DateTime         @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingUpdates   Boolean  @default(true)
  chatMessages     Boolean  @default(true)
  paymentUpdates   Boolean  @default(true)
  serviceReminders Boolean  @default(true)
  reviewReminders  Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  REVIEWED
  RESOLVED
  DISMISSED
  ESCALATED
}

model Report {
  id              String       @id @default(uuid())
  reporterUserId  String
  reporterUser    User         @relation("ReportedBy", fields: [reporterUserId], references: [id], onDelete: Restrict)
  reportedUserId  String?
  reportedUser    User?        @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  bookingId       String?
  booking         Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  messageId       String?
  message         Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  reviewId        String?
  review          Review?      @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  reason          String
  details         String?
  priority        String?      @default("MEDIUM")
  status          ReportStatus @default(PENDING)
  assignedAdminId String?
  assignedAdmin   User?        @relation("ReportAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  resolutionNotes String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([reporterUserId])
  @@index([reportedUserId])
  @@index([bookingId])
  @@index([status])
  @@index([assignedAdminId])
}

model Block {
  id            String   @id @default(uuid())
  blockerUserId String
  blockerUser   User     @relation("BlockedBy", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blockedUserId String
  blockedUser   User     @relation("BlockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)
  reason        String?
  createdAt     DateTime @default(now())

  @@unique([blockerUserId, blockedUserId])
  @@index([blockerUserId])
  @@index([blockedUserId])
}

// ==========================================
// Phase 7: Trust, Safety & Operations Models
// ==========================================

enum VerificationStatus {
  NOT_SUBMITTED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  NEEDS_INFORMATION
}

model VerificationRecord {
  id                String             @id @default(uuid())
  providerProfileId String
  providerProfile   ServiceProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  verificationType  String             // "IDENTITY", "TRADE_CERTIFICATION", "POLICE_CLEARANCE", "ADDRESS_PROOF", "BUSINESS_REGISTRATION"
  status            VerificationStatus @default(SUBMITTED)
  documents         Json?              // Array of { id, type, title, fileName, fileSizeFormatted, status, previewUrl }
  reviewerNotes     String?
  rejectionReason   String?
  reviewedByAdminId String?
  reviewedByAdmin   User?              @relation("VerificationReviewedBy", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  submittedAt       DateTime           @default(now())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([providerProfileId])
  @@index([status])
  @@index([verificationType])
  @@index([reviewedByAdminId])
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  WAITING_FOR_INFO
  RESOLVED
  CLOSED
  ESCALATED
}

enum DisputePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Dispute {
  id                  String          @id @default(uuid())
  caseNumber          String          @unique // e.g. "DSP-10001"
  bookingId           String?
  booking             Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  openedByUserId      String
  openedByUser        User            @relation("DisputeOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  respondentUserId    String?
  respondentUser      User?           @relation("DisputeRespondent", fields: [respondentUserId], references: [id], onDelete: SetNull)
  category            String          // "PAYMENT_ISSUE", "SERVICE_QUALITY", "CANCELLATION_REFUND", "COMMUNICATION", "SAFETY_TRUST", "PROPERTY_DAMAGE", "OTHER"
  priority            DisputePriority @default(MEDIUM)
  status              DisputeStatus   @default(OPEN)
  issueSummary        String
  detailedDescription String
  amountInvolvedPaise Int?
  assignedAdminId     String?
  assignedAdmin       User?           @relation("DisputeAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  internalNotes       String?
  resolutionSummary   String?
  resolvedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([bookingId])
  @@index([openedByUserId])
  @@index([status])
  @@index([priority])
  @@index([caseNumber])
  @@index([assignedAdminId])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id              String                @id @default(uuid())
  ticketNumber    String                @unique // e.g. "TKT-10001"
  requesterUserId String?
  requesterUser   User?                 @relation("SupportTicketRequester", fields: [requesterUserId], references: [id], onDelete: SetNull)
  requesterRole   String                @default("CUSTOMER") // "CUSTOMER", "PROVIDER", "GENERAL"
  contactEmail    String?
  contactPhone    String?
  category        String
  subject         String
  description     String
  status          SupportTicketStatus   @default(OPEN)
  priority        SupportTicketPriority @default(MEDIUM)
  assignedAdminId String?
  assignedAdmin   User?                 @relation("SupportTicketAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  bookingId       String?
  booking         Booking?              @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  internalNotes   String?
  resolutionNotes String?
  resolvedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([requesterUserId])
  @@index([status])
  @@index([priority])
  @@index([ticketNumber])
  @@index([assignedAdminId])
}

enum TrustSafetyStatus {
  FLAGGED
  UNDER_REVIEW
  CLEARED
  RESTRICTED
  ESCALATED
}

enum TrustSafetySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model TrustSafetyCase {
  id                 String              @id @default(uuid())
  caseReference      String              @unique // e.g. "TSC-10001"
  entityType         String              // "USER", "PROVIDER", "BOOKING"
  entityId           String
  riskSignal         String
  severity           TrustSafetySeverity @default(MEDIUM)
  status             TrustSafetyStatus   @default(FLAGGED)
  assignedAdminId    String?
  assignedAdmin      User?               @relation("TrustSafetyAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  investigationNotes String?
  resolutionSummary  String?
  resolvedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([entityType, entityId])
  @@index([status])
  @@index([severity])
  @@index([caseReference])
  @@index([assignedAdminId])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String
  actorUser   User     @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  action      String   // e.g. "SUSPEND_USER", "RESTRICT_PROVIDER", "APPROVE_VERIFICATION", "UPDATE_POLICY", "RESOLVE_DISPUTE"
  entityType  String   // "User", "Provider", "Booking", "Verification", "Dispute", "Service", "Setting", "SupportTicket", "TrustSafetyCase"
  entityId    String
  reason      String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model PlatformSetting {
  key              String   @id // e.g. "PLATFORM_COMMISSION_PERCENT", "MAINTENANCE_MODE", "CANCELLATION_WINDOW_HOURS"
  value            Json
  description      String?
  category         String?  @default("GENERAL") // "FINANCIAL", "POLICY", "SYSTEM", "GENERAL"
  updatedByAdminId String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@index([category])
}

// ===================================================
// PHASE 8 — REAL AI / INTELLIGENT PLATFORM MODELS
// ===================================================

model AiInteraction {
  id               String   @id @default(uuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  feature          String   // "SERVICE_REQUEST_PARSE", "MATCHING_ASSISTANCE", "REVIEW_SUMMARY", "SUPPORT_ASSISTANT", etc.
  provider         String   // "GEMINI", "OPENAI", etc.
  model            String
  promptHash       String?
  structuredOutput Json?
  validationPassed Boolean  @default(true)
  latencyMs        Int
  tokensUsed       Int?
  isSuccess        Boolean  @default(true)
  errorMessage     String?
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([feature])
  @@index([createdAt])
  @@index([isSuccess])
}

model AiRequestInterpretation {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawTextHash        String
  extractedIntent    Json
  categorySlug       String?
  serviceSlug        String?
  isConfirmed        Boolean  @default(false)
  confirmedBookingId String?
  model              String
  provider           String
  createdAt          DateTime @default(now())

  @@index([userId])
  @@index([categorySlug])
  @@index([serviceSlug])
  @@index([createdAt])
}

model AiReviewSummary {
  id                    String                 @id @default(uuid())
  providerProfileId     String                 @unique
  providerProfile       ServiceProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  summaryText           String
  positiveThemes        String[]
  areasForImprovement   String[]
  reviewCountAnalyzed   Int
  averageRatingSnapshot Float
  model                 String
  provider              String
  generatedAt           DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([providerProfileId])
  @@index([generatedAt])
}

model AiOperationalSignal {
  id                String    @id @default(uuid())
  signalType        String    // "PRICE_ANOMALY", "DUPLICATE_PROFILE", "DEMAND_SURGE"
  severity          String    // "LOW", "MEDIUM", "HIGH"
  entityType        String    // "BOOKING", "PROVIDER", "CATEGORY"
  entityId          String
  details           Json
  model             String
  provider          String
  status            String    @default("PENDING_REVIEW") // "PENDING_REVIEW", "ACKNOWLEDGED", "DISMISSED"
  reviewedByAdminId String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([signalType])
  @@index([entityType, entityId])
  @@index([status])
  @@index([createdAt])
}
